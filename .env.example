# ==============================================================================
# SellerPulse Environment Configuration
# Copy this file to .env and adjust variables as required.
# ==============================================================================

# Application Environment (development, staging, production)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Configuration (SQLite WAL mode by default)
DATABASE_URL=sqlite:///./data/sellerpulse.db

# API Security (X-API-Key header authentication)
API_KEY=sk_live_sellerpulse_demo_key_99
API_HOST=0.0.0.0
API_PORT=8000

# Streamlit Dashboard Configuration
DASHBOARD_PORT=8501

# Inventory Analytics & Thresholds
DEAD_STOCK_DAYS=90
SLOW_STOCK_DAYS=60
LOW_STOCK_DAYS_THRESHOLD=14
MARGIN_FLOOR_PCT=0.15

# Automation & Alerts
ALERTS_WEBHOOK_ENABLED=false
ALERTS_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
ALERTS_TELEGRAM_BOT_TOKEN=
ALERTS_TELEGRAM_CHAT_ID=

# Scheduled Jobs Interval (seconds / cron)
ETL_SYNC_INTERVAL_HOURS=24
ALERTS_CHECK_INTERVAL_HOURS=1
REPORTS_DIR=./reports_out
